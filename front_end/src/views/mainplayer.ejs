<html>
    <head>
            <title></title>
            <link rel="stylesheet" media="screen" href="mainplayer/css/mainplayer.css" type="text/css"/>
            <link rel="stylesheet" href="Fonts/stylesheet.css" type="text/css" charset="utf-8"/>
                
            <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
            <script defer src="mainplayer/js/mainplayer.js"></script>
    </head>
    <body>
        <div id="VideoFrame">
            <video class="video" src="<%= url %>" volume="20"></video>
            <button id="PlayPause" class="bigbutton">pause</button>
            
                <div id="VolumeDiv">
                    
                    <div id="VD">
                        <p id="VolumePercentage"> 20 </p>
                        <div id="VolumeTimeLineHolder">
                            <div id="VolumeTimeLine">
                            </div>
                        </div>
                    </div>

                    <img src="mainplayer/Volume_1.png" id="Volume" onclick="VolumeB()">

                </div>
                <div id="VideoDiv">
                    <div id="TimelineSelectionArea">
                        <div id="VideoTimeLineHolder">
                            <div id="VideoTimeLineDownload">
                            </div>
                            <div id="VideoTimeLineHover">
                                
                            </div>
                            <div id="VideoTimeLine">
                                
                            </div>
                        
                        </div>
                    </div>
                </div>
                <div id="VideoSettingsDiv">
                    <img src="mainplayer/Settings.png" id="VideoSettingsButton" onclick="SettingsB()">

                </div>
                <video id="FramePreview" src="<%= url %>" ></video>
                <p id="CTime"> MM:SS / CM:CS</p> 

                <div id="FullscreenDiv">
                <img src="mainplayer/Enter_Fullscreen.png" id="ScreenResize" onclick="openFullscreen()">
                </div>
        </div>       
            
    </body>
    
</html>
